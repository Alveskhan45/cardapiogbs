{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    /* Adoção incremental de tipos em JS legado.
       checkJs fica false: cada arquivo entra na malha quando ganha
       `// @ts-check` + JSDoc. A regra só endurece (nunca afrouxa). */
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"]
  },
  "include": [
    "server.js",
    "lib/**/*.js",
    "middleware/**/*.js",
    "routes/**/*.js",
    "services/**/*.js",
    "db/**/*.js",
    "tests/**/*.js"
  ],
  "exclude": ["node_modules", "js/vendor"]
}
