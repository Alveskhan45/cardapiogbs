# ============================================================================
# Cardapio Digital SaaS — variaveis de ambiente finais
# Copie para .env e substitua todos os valores de exemplo antes do deploy.
# Nunca versionar .env em producao.
# ============================================================================

# --- Banco (PostgreSQL) -----------------------------------------------------
# Em desenvolvimento local, normalmente o compose publica em 5433.
# Em producao, use usuarios separados para app e super-admin.
DATABASE_URL=postgres://cardapio_app:change_me@db.example.com:5432/cardapio_saas
SUPER_ADMIN_DATABASE_URL=postgres://cardapio_admin:change_me@db.example.com:5432/cardapio_saas

# --- Autenticacao / seguranca -----------------------------------------------
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Requer pelo menos 32 caracteres em producao.
JWT_SECRET=replace_with_a_secure_random_secret_32_chars_min
JWT_AUDIENCE=cardapio-saas
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=30d

# CORS em producao: dominios publicos e subdominios autorizados.
# Exemplo: https://seusaas.com,https://app.seusaas.com,https://admin.seusaas.com
ALLOWED_ORIGINS=https://seusaas.com,https://app.seusaas.com,https://admin.seusaas.com

# --- Tenant -----------------------------------------------------------------
# auto      = subdominio > header X-Tenant-ID > ?tenant= > /t/:slug
# subdomain = somente subdominio (cliente.seusaas.com)
# header    = somente X-Tenant-ID
# path      = somente /t/:slug
TENANT_RESOLVER=auto
WILDCARD_DOMAIN=seusaas.com
# 1 = modo estrito: aceita apenas a fonte configurada em TENANT_RESOLVER.
TENANT_STRICT=0

# --- Super-admin da plataforma -----------------------------------------------
SUPER_ADMIN_EMAIL=admin@seusaas.com
SUPER_ADMIN_PASS=replace_with_a_strong_production_password_min_32_chars

# --- Servidor ---------------------------------------------------------------
PORT=3001
NODE_ENV=production
BACKUP_DIR=./backups
